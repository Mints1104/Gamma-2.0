<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup rules for Android 11 and lower (API 30-). data_extraction_rules.xml covers
   Android 12+ and must list the same exclusions; see it for why each file is left out.
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <exclude domain="sharedpref" path="quest_cache.xml" />
    <exclude domain="sharedpref" path="pokemon_cache.xml" />
    <exclude domain="sharedpref" path="overlay_prefs.xml" />
</full-backup-content>
